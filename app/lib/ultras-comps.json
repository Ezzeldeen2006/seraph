  {
    "boss": "UltraAvatarTyndarius",
    "name": "seraph-loo-ap-lr-vhl",
    "why": "the owner's recipe (2026-10-26): ArchPaladin and Lord of Order both taunt Tyndarius (12 s loops, 6 s apart), Legion Revenant taunts the left orb, Void Highlord the right orb. The 10-22 line-up left the right orb untaunted and LoO never taunted.",
    "entries": [
      {
        "class": "Lord of Order",
        "role": "TyndariusAttacker",
        "scroll": "ScrollOfEnrage",
        "taunt": {
          "every": 12,
          "atSec": 6
        },
        "potions": [
          "Body Tonic",
          "Unstable Divine Elixir"
        ]
      },
      {
        "class": "ArchPaladin",
        "role": "TyndariusTaunter",
        "scroll": "ScrollOfEnrage",
        "taunt": {
          "raw": "UltraTaunt.Every(12, atSec: 0, beforeTaunt: SealUp, beforeTauntDescription: \"Righteous Seal up\")"
        },
        "potions": [
          "Body Tonic",
          "Potent Destruction Elixir"
        ]
      },
      {
        "class": "Legion Revenant",
        "role": "LeftOrbTaunter",
        "scroll": "ScrollOfEnrage",
        "taunt": {
          "raw": "UltraTaunt.ByRole(\"whenever the left orb is up\")"
        },
        "potions": [
          "Sage Tonic",
          "Potent Malevolence Elixir"
        ]
      },
      {
        "class": "Void Highlord",
        "role": "RightOrbTaunter",
        "scroll": "ScrollOfEnrage",
        "taunt": {
          "raw": "UltraTaunt.ByRole(\"whenever the right orb is up\")"
        },
        "potions": [
          "Body Tonic",
          "Potent Destruction Elixir"
