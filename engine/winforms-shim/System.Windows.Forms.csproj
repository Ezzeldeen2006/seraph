<Project Sdk="Microsoft.NET.Sdk">
  <!-- A do-nothing System.Windows.Forms for a host with no screen (and no WinForms on Linux).
       Only what the Skua scripts reference: CoreBots' April Fools progress window. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>System.Windows.Forms</AssemblyName>
    <RootNamespace>System.Windows.Forms</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <NoWarn>$(NoWarn);CS0067;CS1591</NoWarn>
  </PropertyGroup>
</Project>
